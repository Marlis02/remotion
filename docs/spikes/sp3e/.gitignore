#   cp ../sp3/assets/DejaVuSans-Bold.ttf src/remotion/public/ && cp ../sp3/assets/DejaVuSans-Bold.ttf src/hyperframes/
#   cp ../sp3c/src/gsap.min.js src/hyperframes/
src/remotion/public/DejaVuSans-Bold.ttf
